/E (-- =================================================== -- PHARMACY MANAGEMENT SYSTEM:DDLSCRIPT\(P ART 1\) -- =================================================== CREATE TABLE suppliers \( supplier_idSERIAL PRIMARY KEY, company_name VARCHAR\(100\) NOT NULL, contact_name VARCHAR\(100\), phone_number VARCHAR\(15\)UNIQ UE NOT NULL, email VARCHAR\(100\), city VARCHAR\(50\), created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\);CREA TE TABLE medicines \( medicine_id SERIAL PRIMARY KEY, supplier_id INT REFERENCES suppliers\(supplier_id\)ON DELETE SET NULL, brand_name VARCHAR\(100\) NOT NULL, generic_name VARCHAR\(100\) NOT NULL, categoryVARCHAR\(5 0\) CHECK \(category IN \('Tablet', 'Syrup', 'Injection', 'Ointment', 'Equipment'\)\), unit_priceNUMERIC\(10, 2\) NOT NULL CHECK \(unit_price > 0\), reorder_level INT DEFAULT 50, created_at TIMESTAMP DEFAULTCURRENT_TI MESTAMP \); CREATE TABLE inventory_batches \( batch_id SERIAL PRIMARY KEY, medicine_id INT REFERENCESmedic ines\(medicine_id\) ON DELETE CASCADE, batch_number VARCHAR\(50\) NOT NULL UNIQUE, quantity_in_stockINTNOT NULLCHECK \(quantity_in_stock >= 0\), manufacturing_date DATE NOT NULL, expiry_date DATE NOTNULL,purchas e_price NUMERIC\(10, 2\) NOT NULL, CONSTRAINT chk_expiry CHECK \(expiry_date > manufacturing_date\)\);)
/Pg 16 0 R
/K [6]
>>
endobj
