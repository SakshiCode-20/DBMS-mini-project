/Type /StructElem
/S /P
/P 107 0 R
/E (--=================================================== -- REPORT QUERY 1: DETAILED DAILY SALES REPO RT--=================================================== SELECT i.invoice_id, i.invoice_date::DATE AS sa le_date,CONCAT\(c.first_name, ' ', c.last_name\) AS customer_name, m.brand_name, b.batch_number, ii.quanti ty_sold,ii.unit_price, ii.subtotal, i.payment_mode FROM sales_invoices i JOIN customers c ON i.customer_ id=c.customer_id JOIN invoice_items ii ON i.invoice_id = ii.invoice_id JOIN inventory_batches b ON ii.b atch_id=b.batch_id JOIN medicines m ON b.medicine_id = m.medicine_id ORDER BY i.invoice_date DESC; -- = ================================================== -- REPORT QUERY 2: SUPPLIER REVENUE & VOLUME SUMMARY - -=================================================== SELECT s.company_name, COUNT\(DISTINCT m.medicine_i d\)AStotal_products_supplied, SUM\(ii.quantity_sold\) AS total_units_sold, SUM\(ii.subtotal\) AS gross_reven ue_generated FROM suppliers s JOIN medicines m ON s.supplier_id = m.supplier_id JOIN inventory_batches b ONm.medicine_id = b.medicine_id JOIN invoice_items ii ON b.batch_id = ii.batch_id GROUP BY s.supplier_i d,s.company_name ORDER BY gross_revenue_generated DESC;)
/Pg 21 0 R
/K [4]
>>
endobj
