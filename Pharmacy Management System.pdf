/E (-- =================================================== -- TRIGGER: AUTOMATIC STOCK DEDUCTION UPON S ALE -- =================================================== CREATE OR REPLACE FUNCTION update_stock_after_ sale\(\) RETURNSTRIGGER AS $$ BEGIN -- Check if sufficient stock exists IF \(SELECT quantity_in_stock FROM inventory_batchesWHERE batch_id = NEW.batch_id\) < NEW.quantity_sold THEN RAISE EXCEPTION 'Stock alert: I nsufficientbatchquantity for Batch ID %', NEW.batch_id; END IF; -- Deduct stock UPDATE inventory_batche sSETquantity_in_stock = quantity_in_stock - NEW.quantity_sold WHERE batch_id = NEW.batch_id; RETURN NE W;END;$$LANGUAGEplpgsql; CREATE TRIGGER trg_deduct_inventory AFTER INSERT ON invoice_items FOR EACH R OWEXECUTEFUNCTIONupdate_stock_after_sale\(\); -- TRIGGER: AUTOMATIC INVOICE TOTAL CALCULATION CREATE OR REPLACEFUNCTIONupdate_invoice_total\(\) RETURNS TRIGGER AS $$ BEGIN UPDATE sales_invoices SET total_amoun t=\(SELECTCOALESCE\(SUM\(subtotal\), 0\) FROM invoice_items WHERE invoice_id = NEW.invoice_id \) WHERE invo ice_id=NEW.invoice_id; RETURN NEW; END; $$ LANGUAGE plpgsql; CREATE TRIGGER trg_update_invoice_total AF TERINSERTONinvoice_items FOR EACH ROW EXECUTE FUNCTION update_invoice_total\(\);)
/Pg 19 0 R
/K [6]
>>
endobj
